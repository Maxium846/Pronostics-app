# Modèle des variables d'environnement de production.
# Copier ce fichier en ".env" (même dossier), puis remplacer les valeurs.
# Le vrai fichier ".env" est ignoré par Git : ne JAMAIS le commiter.

DB_URL=jdbc:postgresql://postgres:5432/pronoleague
DB_USER=pronoleague
DB_PASSWORD=remplacer-par-un-mot-de-passe-long-et-aleatoire
CORS_ALLOWED_ORIGINS=
